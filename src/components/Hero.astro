---
interface Props {
  title: string;
  subtitle?: string;
  dogImageUrl?: string;
}

const { title, subtitle, dogImageUrl = "https://images.unsplash.com/photo-1587300003388-59208cc962cb?w=400&h=300&fit=crop" } = Astro.props;
---

<section class="hero-section">
  <div class="pastel-left"></div>
  <div class="hero-content">
    <h1 class="hero-title">
      {title}
    </h1>
    <div class="dog-image-container">
      <img 
        src={dogImageUrl} 
        alt="Imagen de un perro adorable" 
        class="dog-image"
        loading="lazy"
      />
    </div>
    {subtitle && (
      <p class="hero-subtitle">
        {subtitle}
      </p>
    )}
  </div>
  <div class="pastel-right"></div>
</section>

<style>
  .hero-section {
    display: flex;
    min-height: 80vh;
    position: relative;
  }

  .pastel-left {
    width: var(--space-3xl);
    background: linear-gradient(180deg, 
      oklch(0.93 0.05 350) 0%, 
      oklch(0.92 0.06 280) 100%);
    flex-shrink: 0;
  }

  .pastel-right {
    width: var(--space-3xl);
    background: linear-gradient(180deg, 
      oklch(0.92 0.05 200) 0%, 
      oklch(0.93 0.05 160) 100%);
    flex-shrink: 0;
  }

  .hero-content {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: var(--space-2xl) var(--space-md);
    background-color: var(--color-background);
    text-align: center;
  }

  .hero-title {
    font-family: "Comic Sans MS", "Comic Sans", cursive;
    font-size: var(--text-6xl);
    font-weight: var(--font-bold);
    color: var(--color-error);
    line-height: var(--leading-tight);
    margin-bottom: var(--space-xl);
  }

  .dog-image-container {
    margin: var(--space-xl) 0;
  }

  .dog-image {
    max-width: 100%;
    height: auto;
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-lg);
  }

  .hero-subtitle {
    font-size: var(--text-lg);
    color: var(--color-muted);
    line-height: var(--leading-relaxed);
    max-width: 36rem;
  }

  @media (max-width: 48rem) {
    .pastel-left,
    .pastel-right {
      width: var(--space-lg);
    }

    .hero-title {
      font-size: var(--text-4xl);
    }
  }
</style>
