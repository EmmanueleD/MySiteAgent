---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import Section from "../components/Section.astro";
import Container from "../components/Container.astro";
import Footer from "../components/Footer.astro";
---

<Layout title="MySiteAgent">
  <Hero
    title="Benvenuto nel futuro"
    subtitle="La piattaforma AI per gestire i contenuti del tuo sito Astro"
    ctaLabel="Accedi all'Admin"
    ctaHref="/ai-admin"
  />

  <Section background="surface" padding="lg">
    <Container maxWidth="md">
      <p
        style="font-size: var(--text-lg); color: var(--color-muted); line-height: var(--leading-relaxed); text-align: center; margin: 0;"
      >
        Modifica i contenuti del tuo sito con l'intelligenza artificiale.
        Semplice, veloce e potente.
      </p>
    </Container>
  </Section>

  <Footer
    siteName="MySiteAgent"
    sections={[
      {
        title: "Prodotto",
        links: [
          { label: "Funzionalità", href: "/features" },
          { label: "Prezzi", href: "/pricing" },
          { label: "Documentazione", href: "/docs" }
        ]
      },
      {
        title: "Azienda",
        links: [
          { label: "Chi siamo", href: "/about" },
          { label: "Blog", href: "/blog" },
          { label: "Contatti", href: "/contact" }
        ]
      },
      {
        title: "Legale",
        links: [
          { label: "Privacy", href: "/privacy" },
          { label: "Termini", href: "/terms" }
        ]
      }
    ]}
    socialLinks={[
      { icon: "★", href: "https://github.com", label: "GitHub" },
      { icon: "♥", href: "https://twitter.com", label: "Twitter" }
    ]}
  />
</Layout>
