---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import Section from "../components/Section.astro";
import Container from "../components/Container.astro";
import Footer from "../components/Footer.astro";
---

<Layout title="MySiteAgent">
  <Hero
    title="Benvenuto nel futuro"
    subtitle="La piattaforma AI per gestire i contenuti del tuo sito Astro"
    ctaLabel="Accedi all'Admin"
    ctaHref="/ai-admin"
  />

  <Section background="surface" padding="lg">
    <Container maxWidth="md">
      <p
        style="font-size: var(--text-lg); color: var(--color-muted); line-height: var(--leading-relaxed); text-align: center; margin: 0;"
      >
        Modifica i contenuti del tuo sito con l'intelligenza artificiale.
        Semplice, veloce e potente.
      </p>
    </Container>
  </Section>

  <Section background="dark" padding="xl">
    <Container maxWidth="md">
      <div class="cta-block">
        <h2 class="cta-block__title">Hai bisogno di aiuto?</h2>
        <p class="cta-block__text">
          Il nostro team è pronto ad assisterti. Contattaci subito per una
          consulenza gratuita e scopri come possiamo aiutarti.
        </p>
        <a href="tel:3514590525" class="cta-block__button">
          📞 Chiamaci al 351 459 0525
        </a>
      </div>
    </Container>
  </Section>

  <Footer
    siteName="MySiteAgent"
    sections={[
      {
        title: "Prodotto",
        links: [
          { label: "Funzionalità", href: "/features" },
          { label: "Prezzi", href: "/pricing" },
          { label: "Documentazione", href: "/docs" }
        ]
      },
      {
        title: "Azienda",
        links: [
          { label: "Chi siamo", href: "/about" },
          { label: "Blog", href: "/blog" },
          { label: "Contatti", href: "/contact" }
        ]
      },
      {
        title: "Legale",
        links: [
          { label: "Privacy", href: "/privacy" },
          { label: "Termini", href: "/terms" }
        ]
      }
    ]}
    socialLinks={[
      { icon: "★", href: "https://github.com", label: "GitHub" },
      { icon: "♥", href: "https://twitter.com", label: "Twitter" }
    ]}
  />
</Layout>

<style>
  .cta-block {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--space-xl);
  }

  .cta-block__title {
    font-family: var(--font-display);
    font-size: var(--text-4xl);
    font-weight: var(--font-bold);
    color: var(--color-foreground);
    line-height: var(--leading-tight);
    margin: 0;
  }

  .cta-block__text {
    font-size: var(--text-lg);
    color: var(--color-muted);
    line-height: var(--leading-relaxed);
    margin: 0;
    max-width: 36rem;
  }

  .cta-block__button {
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
    background-color: var(--color-primary);
    color: var(--color-surface);
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: var(--font-bold);
    text-decoration: none;
    padding: var(--space-lg) var(--space-2xl);
    border-radius: var(--radius-lg);
    border: var(--border-thick) solid var(--color-border);
    box-shadow: var(--shadow-primary);
    transition: transform var(--transition-fast), box-shadow var(--transition-fast);
  }

  .cta-block__button:hover {
    transform: translate(calc(var(--space-xs) * -1), calc(var(--space-xs) * -1));
    box-shadow: var(--shadow-xl);
  }

  .cta-block__button:active {
    transform: translate(var(--space-xs), var(--space-xs));
    box-shadow: none;
  }
</style>
