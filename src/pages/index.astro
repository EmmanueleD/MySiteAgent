---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import Section from "../components/Section.astro";
import Container from "../components/Container.astro";
import Footer from "../components/Footer.astro";
---

<Layout title="MySiteAgent">
  <Hero
    title="Benvenuto nel futuro"
    subtitle="La piattaforma AI per gestire i contenuti del tuo sito Astro"
    ctaLabel="Accedi all'Admin"
    ctaHref="/ai-admin"
  />

  <Section background="surface" padding="lg">
    <Container maxWidth="md">
      <p
        style="font-size: var(--text-lg); color: var(--color-muted); line-height: var(--leading-relaxed); text-align: center; margin: 0;"
      >
        Modifica i contenuti del tuo sito con l'intelligenza artificiale.
        Semplice, veloce e potente.
      </p>
    </Container>
  </Section>

  <Section background="default" padding="xl">
    <Container maxWidth="xl">
      <div class="cards-grid">

        <div class="card">
          <div class="card__image" aria-hidden="true">
            <span class="card__image-icon">🚀</span>
          </div>
          <h3 class="card__title">Velocità Estrema</h3>
          <p class="card__text">
            Pubblica aggiornamenti in tempo reale senza toccare una riga di codice. La nostra AI ottimizza ogni contenuto per la massima performance.
          </p>
          <a href="/features" class="card__button">Scopri di più</a>
        </div>

        <div class="card">
          <div class="card__image" aria-hidden="true">
            <span class="card__image-icon">🤖</span>
          </div>
          <h3 class="card__title">Intelligenza Artificiale</h3>
          <p class="card__text">
            Genera testi, immagini e strutture di pagina con un semplice prompt. L'AI capisce il tuo brand e mantiene lo stile coerente.
          </p>
          <a href="/ai-admin" class="card__button">Prova ora</a>
        </div>

      </div>
    </Container>
  </Section>

  <Section background="dark" padding="xl">
    <Container maxWidth="md">
      <div class="cta-block">
        <h2 class="cta-block__title">Hai bisogno di aiuto?</h2>
        <p class="cta-block__text">
          Il nostro team è pronto ad assisterti. Contattaci subito per una
          consulenza gratuita e scopri come possiamo aiutarti.
        </p>
        <a href="tel:3514590525" class="cta-block__button">
          📞 Chiamaci al 351 459 0525
        </a>
      </div>
    </Container>
  </Section>

  <Footer
    siteName="MySiteAgent"
    sections={[
      {
        title: "Prodotto",
        links: [
          { label: "Funzionalità", href: "/features" },
          { label: "Prezzi", href: "/pricing" },
          { label: "Documentazione", href: "/docs" }
        ]
      },
      {
        title: "Azienda",
        links: [
          { label: "Chi siamo", href: "/about" },
          { label: "Blog", href: "/blog" },
          { label: "Contatti", href: "/contact" }
        ]
      },
      {
        title: "Legale",
        links: [
          { label: "Privacy", href: "/privacy" },
          { label: "Termini", href: "/terms" }
        ]
      }
    ]}
    socialLinks={[
      { icon: "★", href: "https://github.com", label: "GitHub" },
      { icon: "♥", href: "https://twitter.com", label: "Twitter" }
    ]}
  />
</Layout>

<style>
  /* Griglia a due colonne */
  .cards-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-xl);
  }

  @media (min-width: 48rem) {
    .cards-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  /* Card */
  .card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-lg);
    background-color: var(--color-surface);
    border: var(--border-medium) solid var(--color-border);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-md);
    padding: var(--space-xl);
    transition: transform var(--transition-fast), box-shadow var(--transition-fast);
  }

  .card:hover {
    transform: translate(calc(var(--space-xs) * -1), calc(var(--space-xs) * -1));
    box-shadow: var(--shadow-xl);
  }

  /* Anteprima immagine della card */
  .card__image {
    width: 100%;
    aspect-ratio: 16 / 9;
    background-color: var(--color-surface-dark);
    border: var(--border-thin) solid var(--color-border-light);
    border-radius: var(--radius-lg);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .card__image-icon {
    font-size: var(--text-5xl);
    line-height: 1;
  }

  /* Testi della card */
  .card__title {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: var(--font-bold);
    color: var(--color-foreground);
    line-height: var(--leading-tight);
    margin: 0;
  }

  .card__text {
    font-size: var(--text-base);
    color: var(--color-muted);
    line-height: var(--leading-relaxed);
    margin: 0;
    flex: 1;
  }

  /* Pulsante della card */
  .card__button {
    display: inline-flex;
    align-items: center;
    background-color: var(--color-primary);
    color: var(--color-surface);
    font-family: var(--font-display);
    font-size: var(--text-sm);
    font-weight: var(--font-bold);
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: var(--space-sm) var(--space-lg);
    border-radius: var(--radius-md);
    border: var(--border-thin) solid var(--color-border);
    box-shadow: var(--shadow-sm);
    transition: transform var(--transition-fast), box-shadow var(--transition-fast);
    margin-top: auto;
  }

  .card__button:hover {
    transform: translate(calc(var(--space-xs) * -1), calc(var(--space-xs) * -1));
    box-shadow: var(--shadow-primary);
  }

  .card__button:active {
    transform: translate(var(--space-xs), var(--space-xs));
    box-shadow: none;
  }

  /* CTA block */
  .cta-block {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--space-xl);
  }

  .cta-block__title {
    font-family: var(--font-display);
    font-size: var(--text-4xl);
    font-weight: var(--font-bold);
    color: var(--color-foreground);
    line-height: var(--leading-tight);
    margin: 0;
  }

  .cta-block__text {
    font-size: var(--text-lg);
    color: var(--color-muted);
    line-height: var(--leading-relaxed);
    margin: 0;
    max-width: 36rem;
  }

  .cta-block__button {
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
    background-color: var(--color-primary);
    color: var(--color-surface);
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: var(--font-bold);
    text-decoration: none;
    padding: var(--space-lg) var(--space-2xl);
    border-radius: var(--radius-lg);
    border: var(--border-thick) solid var(--color-border);
    box-shadow: var(--shadow-primary);
    transition: transform var(--transition-fast), box-shadow var(--transition-fast);
  }

  .cta-block__button:hover {
    transform: translate(calc(var(--space-xs) * -1), calc(var(--space-xs) * -1));
    box-shadow: var(--shadow-xl);
  }

  .cta-block__button:active {
    transform: translate(var(--space-xs), var(--space-xs));
    box-shadow: none;
  }
</style>
